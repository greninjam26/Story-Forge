DATABASE_URL=sqlite:///./storyforge.db
# Production example: postgresql+psycopg://user:password@host:5432/storyforge
WEB_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:8000

# stub | claude | ollama
STORY_PROVIDER=stub
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_INPUT_COST_PER_MILLION_USD=3
ANTHROPIC_OUTPUT_COST_PER_MILLION_USD=15
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# stub | flux
IMAGE_GEN_PROVIDER=stub
IMAGE_GEN_API_KEY=
IMAGE_GEN_MODEL=flux-2-klein-9b
IMAGE_GEN_BASE_URL=https://api.bfl.ai/v1
IMAGE_GEN_REQUEST_TIMEOUT_SECONDS=30
IMAGE_GEN_POLL_TIMEOUT_SECONDS=60
IMAGE_GEN_POLL_INTERVAL_SECONDS=0.5

# Private asset storage: local (default) | r2
# R2 uses Cloudflare's S3-compatible API and keeps stable r2:// references in
# the database instead of expiring URLs.
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Lifetime of signed private-asset URLs returned to clients, in seconds.
R2_PRESIGN_TTL_SECONDS=3600
ASSET_CACHE_DIR=./asset_cache
TTS_PROVIDER=stub
# Paid ElevenLabs calls require explicit operator approval in addition to
# selecting the provider and supplying credentials.
PAID_TTS_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_REQUEST_TIMEOUT_SECONDS=60
NARRATION_CACHE_DIR=./audio_cache
# Set the current account rate when ElevenLabs is enabled. If omitted, its
# generation cost remains explicitly unknown instead of being reported free.
# ELEVENLABS_COST_PER_CHARACTER_USD=0.0002

# Runaway-cost alarm, not a spending limit. Exceeding the known-cost ceiling
# flags the generation run but does not interrupt story generation.
STORY_COST_CEILING_USD=0.25
