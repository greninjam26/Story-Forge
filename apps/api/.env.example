# Production refuses to start without OpenAI moderation and its API key.
APP_ENVIRONMENT=development
DATABASE_URL=sqlite:///./storyforge.db
# Production example: postgresql+psycopg://user:password@host:5432/storyforge
WEB_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:8000

# stub | claude | groq | ollama
STORY_PROVIDER=groq
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_INPUT_COST_PER_MILLION_USD=3
ANTHROPIC_OUTPUT_COST_PER_MILLION_USD=15
GROQ_API_KEY=
# Strict JSON Schema is supported by openai/gpt-oss-20b and -120b.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=60
# Defaults reflect Groq's Free plan. Set account rates here if billing applies.
GROQ_INPUT_COST_PER_MILLION_USD=0
GROQ_OUTPUT_COST_PER_MILLION_USD=0
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Generated-text safety: stub (free/offline keyword prefilter) | openai
# Selecting openai enables a real network request to the moderation endpoint.
SAFETY_PROVIDER=stub
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_MODERATION_TIMEOUT_SECONDS=10

# stub | flux (direct BFL, paid) | cloudflare (Workers AI)
IMAGE_GEN_PROVIDER=stub
IMAGE_GEN_API_KEY=
IMAGE_GEN_MODEL=flux-2-klein-9b
IMAGE_GEN_BASE_URL=https://api.bfl.ai/v1
IMAGE_GEN_REQUEST_TIMEOUT_SECONDS=30
IMAGE_GEN_POLL_TIMEOUT_SECONDS=60
IMAGE_GEN_POLL_INTERVAL_SECONDS=0.5
CLOUDFLARE_AI_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/black-forest-labs/flux-2-klein-4b
CLOUDFLARE_AI_BASE_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_AI_TIMEOUT_SECONDS=120
# Keep at zero on Workers Free. Set the effective per-image cost when paid
# overage is enabled so Story Forge's cost ledger remains accurate.
CLOUDFLARE_AI_COST_PER_IMAGE_USD=0

# Private asset storage: local (default) | r2
# R2 uses Cloudflare's S3-compatible API and keeps stable r2:// references in
# the database instead of expiring URLs.
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Lifetime of signed private-asset URLs returned to clients, in seconds.
R2_PRESIGN_TTL_SECONDS=3600
# Process queued asset deletions when the API starts and every interval.
ASSET_CLEANUP_WORKER_ENABLED=true
ASSET_CLEANUP_WORKER_INTERVAL_SECONDS=60
# Recover generation jobs abandoned by a stopped API process.
STORY_GENERATION_RECOVERY_ENABLED=true
STORY_GENERATION_WORKER_INTERVAL_SECONDS=60
# How long an Idempotency-Key remains reusable for POST /stories, in hours.
# Expired keys are purged lazily when a new key is recorded.
IDEMPOTENCY_KEY_TTL_HOURS=24
# Transient provider errors (429, 5xx, network) are retried with exponential
# backoff.  Non-transient errors (malformed output, validation) propagate
# immediately; the generation worker re-queue handles those.
PROVIDER_RETRY_ATTEMPTS=3
PROVIDER_RETRY_BASE_DELAY_SECONDS=1.0
PROVIDER_RETRY_MAX_DELAY_SECONDS=8.0
# JWT authentication settings.  Change JWT_SECRET_KEY in production.
JWT_SECRET_KEY=dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# Registration checks whether the email domain has MX/A/AAAA mail routing.
# DNS timeouts and unavailable nameservers fail open; confirmed nonexistent or
# non-mail domains are rejected. This cannot prove that a mailbox is owned.
REGISTRATION_EMAIL_DOMAIN_CHECK_ENABLED=true
REGISTRATION_EMAIL_DNS_TIMEOUT_SECONDS=3
# stub | cloudflare (Workers AI MeloTTS) | deepinfra (Kokoro) | elevenlabs
TTS_PROVIDER=stub
# Cloudflare narration reuses CLOUDFLARE_AI_ACCOUNT_ID,
# CLOUDFLARE_AI_API_TOKEN, and CLOUDFLARE_AI_BASE_URL above.
CLOUDFLARE_TTS_MODEL=@cf/myshell-ai/melotts
CLOUDFLARE_TTS_TIMEOUT_SECONDS=60
# Zero is the effective rate only on Workers Free. Workers Paid deployments
# must set the current USD rate per 1,000 neurons after billing review.
CLOUDFLARE_TTS_COST_PER_THOUSAND_NEURONS_USD=0
# Paid DeepInfra and ElevenLabs calls require explicit operator approval in
# addition to selecting the provider and supplying credentials.
PAID_TTS_ENABLED=false
# DeepInfra Kokoro uses af_heart for English and ff_siwis for French by
# default. Use a model-scoped, spend-capped token in production.
DEEPINFRA_API_TOKEN=
DEEPINFRA_TTS_BASE_URL=https://api.deepinfra.com/v1
DEEPINFRA_TTS_MODEL=hexgrad/Kokoro-82M
DEEPINFRA_TTS_EN_VOICE=af_heart
DEEPINFRA_TTS_FR_VOICE=ff_siwis
DEEPINFRA_TTS_SPEED=1.0
DEEPINFRA_TTS_TIMEOUT_SECONDS=60
# Current public Kokoro price: $0.62 per 1,000,000 input characters.
DEEPINFRA_TTS_COST_PER_CHARACTER_USD=0.00000062
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_REQUEST_TIMEOUT_SECONDS=60
NARRATION_CACHE_DIR=./audio_cache
# Set the current account rate when ElevenLabs is enabled. If omitted, its
# generation cost remains explicitly unknown instead of being reported free.
# ELEVENLABS_COST_PER_CHARACTER_USD=0.0002

# Runaway-cost alarm, not a spending limit. Exceeding the known-cost ceiling
# flags the generation run but does not interrupt story generation.
STORY_COST_CEILING_USD=0.25

# Rate limiting: sliding-window per-IP limits on auth and story endpoints.
# Disabled by default so local dev, CI, and tests are unaffected.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_WINDOW=60
RATE_LIMIT_WINDOW_SECONDS=3600

# Sentry error reporting. Disabled when SENTRY_DSN is unset; the app
# never makes network calls for monitoring unless a DSN is provided.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=

# Stripe billing. Disabled when all three keys are unset; in dev/demo
# mode, POST /billing/checkout stubs a subscription directly.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
FREE_STORIES_LIMIT=5

# Trusted hosts middleware. In production, set to your actual domain(s).
# TRUSTED_HOSTS=["yourdomain.com"]

# Postgres connection pooling (ignored for SQLite).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE_SECONDS=1800
